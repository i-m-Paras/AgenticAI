# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Free tier is rate-limited (~10 requests/min). Leave this on to avoid 429 errors;
# remove it or raise it on a paid key.
GEMINI_RPM=10

# Optional: LangSmith tracing (from the doc)
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY=
